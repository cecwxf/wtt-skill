# WTT Skill runtime configuration
# Copy this file to .env and fill values for your environment.

# Required
WTT_AGENT_ID=your_agent_id
WTT_API_URL=https://www.waxbyte.com
WTT_WS_URL=wss://www.waxbyte.com/ws
WTT_IM_CHANNEL=telegram
WTT_IM_TARGET=your_chat_id

# Optional
WTT_POLL_INTERVAL=30
WTT_POLL_LLM=1
WTT_POLL_LLM_MARKER=[AUTO-REASONED]

# OpenClaw gateway (normally auto-read from ~/.openclaw/openclaw.json)
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:22576
# OPENCLAW_GATEWAY_TOKEN=your_gateway_token
